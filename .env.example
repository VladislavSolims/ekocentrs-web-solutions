# How /izveidot (the agent page) is kept away from clients. No default — an
# unset value is a hard error, so a forgotten variable cannot leave it open.
#
#   external — something in front of the app guards it: Cloudflare Access, an
#              IP allowlist, HTTP auth on the web server. Nothing else needed.
#   joomla   — the app checks a signed hand-off from ekocentrs.lv itself, so
#              agents log in with their existing Joomla password. Needs the
#              three variables below.
AGENT_LOGIN=external

# --- only for AGENT_LOGIN=joomla -------------------------------------------
# Generate each secret separately:  openssl rand -hex 32

# Shared with kyc-sso.php on the Joomla side — both must hold the same value.
# JOOMLA_SSO_SECRET=

# Ours alone; signs the agent's session cookie. Must differ from the one above.
# SESSION_SECRET=

# Where an agent without a session is sent to log in (the Joomla bridge).
# JOOMLA_LOGIN_URL=https://ekocentrs.lv/kyc-sso.php
